  "info": {
    "_postman_id": "02d060ce-ea85-42a5-a177-dfb9c7af98be",
    "name": "Metrilo Tracking & CRM Categories API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Metrilo's server-side ingestion API for ecommerce analytics, CRM, and email marketing. Push customers, categories, products, and orders (single or batch) into a Metrilo project. All requests are POST with a JSON envelope of `{ time, token, params }`. Every backend endpoint except `/customer` requires an `X-Digest` header containing an HMAC-SHA256 of the raw request body keyed with the project's API Secret.\n\nContact Support:\n Name: Metrilo",
      "type": "text/plain"
    }
  }
